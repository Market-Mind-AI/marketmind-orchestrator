# Path prefix a reverse proxy serves this API under and strips before
# forwarding. Empty locally, "/orchestrator" behind the cluster ingress.
ROOT_PATH=

# --- The services this drives ---
WORLDBANK_API_URL=http://host.docker.internal:8003
OECD_API_URL=http://host.docker.internal:8001
UN_API_URL=http://host.docker.internal:8002
PYTRENDS_API_URL=http://host.docker.internal:8000

# The scoring service, and the shared secret its /internal tools require. They
# write — they register analyses, collect, and complete requests — so without
# this token every call is refused.
SCORING_API_URL=http://host.docker.internal:8004
SCORING_INTERNAL_TOKEN=

# --- Durable execution ---
# An analysis can run for hours: it insists on a source that is down rather than
# dropping a market, and it may be resumed after the pod that started it is
# gone. Where the graph got to has to outlive the process.
#
# "postgres" needs CHECKPOINTER_DATABASE_URL and is the only setting fit for a
# deployment. "memory" loses every in-flight run on restart, so it has to be
# asked for by name rather than fallen back to: durability that quietly is not
# there is worse than none, because nothing looks wrong until a restart.
#
# Given in parts, matching every other service here. A whole URL would carry a
# second copy of the database password, and the password already lives in the
# vault once — changing it would then mean remembering two places, with the
# second failing silently.
#
# It points at the database every service currently shares: the checkpointer
# creates its own tables there on startup, the same way each service creates
# its own. When the databases are split again, these values change and no code
# does.
CHECKPOINTER=postgres
CHECKPOINTER_DB_HOST=host.docker.internal
CHECKPOINTER_DB_PORT=5436
CHECKPOINTER_DB_NAME=marketmind_core
CHECKPOINTER_DB_USER=marketmind
CHECKPOINTER_DB_PASSWORD=
# Or, for a local one-liner, the whole thing at once — this wins when set.
# CHECKPOINTER_DATABASE_URL=

# --- Tracing ---
# Every run becomes a tree: which nodes ran, which tools they called, the tokens
# and the latency of each. That is the record that answers "why did it do that"
# once the thing deciding is a model rather than a branch in the code.
# Unset means untraced, which is allowed — a missing trace loses an explanation,
# it does not corrupt an answer.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LLM ---
EXTRACTION_PROVIDER=claude
REPORT_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
